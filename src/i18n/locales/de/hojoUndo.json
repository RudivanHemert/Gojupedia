    "content": {
      "title": "Hojo Undo (補助運動): Traditionelles Krafttraining",
      "description": "Hojo Undo, was wörtlich 'unterstützendes Training' bedeutet, ist ein wesentlicher Bestandteil des Okinawa Goju-Ryu Karate-Do Systems.",
      "twoMainComponents": {
        "title": "Zwei Hauptbestandteile",
        "strengthExercises": {
          "title": "Kraftübungen",
          "tools": [
            "Chi Ishi: Steinhebelgewicht",
            "Nigiri Game: Griffvasen",
            "Kongoken: Eisernes Oval",
            "Ishi Sashi: Steinerne Vorhängeschlösser"
          ]
        },
        "hardeningExercises": {
          "title": "Abhärtungsübungen",
          "tools": [
            "Makiwara: Schlagbrett",
            "Suna Bako: Sandeimer",
            "Jari Bako: Kieseimer",
            "Tanren Kumite: Partner-Abhärtung"
          ]
        }
      },
      "centralPrinciples": {
        "title": "Zentrale Prinzipien",
        "description": "Der Kern von Hojo Undo ist der koordinierte Einsatz von Körper, Atem und Geist. Diese Harmonisierung folgt denselben Prinzipien wie die Heishugata (Sanchin und Tensho)."
      },
      "historicalBackground": {
        "title": "Historischer Hintergrund",
        "description": "Die meisten Hojo Undo Werkzeuge sind chinesischen Ursprungs. Der Kongoken wurde 1934 von Chojun Miyagi in Hawaii entdeckt."
      },
      "trainingEffects": {
        "title": "Trainingseffekte",
        "physical": [
          "Kraftentwicklung von Muskeln und Muskelketten",
          "Verbesserung der Kraftausdauer",
          "Entwicklung motorischer Fähigkeiten",
          "Verbesserung von Haltung und Balance"
        ],
        "technical": [
          "Kata-Verbesserung (Kaishugata und Heishugata)",
          "Kraftvollere und stabilere Basistechniken",
          "Effektivere Kampftechniken"
        ],
        "mental": [
          "Verbesserte Konzentration und mentale Disziplin",
          "Entwicklung mentaler Stärke",
          "Steigerung des Selbstvertrauens"
        ]
      },
      "safetyGuidelines": {
        "title": "Sicherheitsrichtlinien",
        "points": [
          "Fachkundige Anleitung ist unerlässlich",
          "Fokus auf Koordination von Körper, Atem und Geist",
