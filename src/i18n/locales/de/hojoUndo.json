    "content": {
      "title": "Hojo Undo (補助運動): Traditionelles Krafttraining",
      "description": "Hojo undo, was wörtlich 'unterstützendes Training' bedeutet, ist ein wesentlicher Bestandteil des Okinawa Goju-ryu Karate-do Systems.",
      "twoMainComponents": {
        "title": "Zwei Hauptkomponenten",
        "strengthExercises": {
          "title": "Kraftübungen",
          "tools": [
            "Chi ishi: Steinhebelgewicht",
            "Nigiri game: Greifvasen",
            "Kongoken: Eisener Oval",
            "Ishi sashi: Steinvorhängeschlösser"
          ]
        },
        "hardeningExercises": {
          "title": "Abhärtungsübungen",
          "tools": [
            "Makiwara: Schlagbrett",
            "Suna bako: Sandeimer",
            "Jari bako: Kieseimer",
            "Tanren kumite: Abhärtungsübungen mit Partner"
          ]
        }
      },
      "centralPrinciples": {
        "title": "Zentrale Prinzipien",
        "description": "Der Kern von hojo undo ist die koordinierte Nutzung von Körper, Atem und Geist. Diese Harmonisierung folgt den gleichen Prinzipien wie die heishugata (Sanchin und Tensho)."
      },
      "historicalBackground": {
        "title": "Historischer Hintergrund",
        "description": "Die meisten hojo undo Werkzeuge sind chinesischen Ursprungs. Der kongoken wurde von Chojun Miyagi in Hawaii (1934) entdeckt."
      },
      "trainingEffects": {
        "title": "Trainingseffekte",
        "physical": [
          "Kraftentwicklung von Muskeln und Muskelketten",
          "Verbesserung der Kraftausdauer",
          "Entwicklung motorischer Fähigkeiten",
          "Verbesserung von Haltung und Gleichgewicht"
        ],
        "technical": [
          "Kata-Verbesserung (kaishugata und heishugata)",
          "Kraftvollere und stabilere Grundtechniken",
          "Effektivere Kampftechniken"
        ],
        "mental": [
          "Verbesserte Konzentration und mentale Disziplin",
          "Entwicklung mentaler Stärke",
          "Zunahme des Selbstvertrauens"
        ]
      },
      "safetyGuidelines": {
        "title": "Sicherheitsrichtlinien",
        "points": [
          "Fachkundige Anleitung ist unerlässlich",
          "Fokus auf Koordination von Körper, Atem und Geist",
          "Intensität schrittweise steigern (Anfänger: 2-3 kg)",
          "Technik vor Gewicht",
          "Ausreichende Ruhe zwischen Trainingssitzungen"
        ]
      }
    }
