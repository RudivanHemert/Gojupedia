    "content": {
      "title": "Hojo Undo (補助運動): Traditionel Styrketræning",
      "description": "Hojo undo, som bogstaveligt betyder 'støttende træning', er en væsentlig del af Okinawa Goju-ryu Karate-do systemet.",
      "twoMainComponents": {
        "title": "To Hovedkomponenter",
        "strengthExercises": {
          "title": "Styrkeøvelser",
          "tools": [
            "Chi ishi: Sten vægtstang",
            "Nigiri game: Greb krukker",
            "Kongoken: Jern oval",
            "Ishi sashi: Sten hængelås"
          ]
        },
        "hardeningExercises": {
          "title": "Hærdningsøvelser",
          "tools": [
            "Makiwara: Slagbræt",
            "Suna bako: Sand spand",
            "Jari bako: Grus spand",
            "Tanren kumite: Hærdningsøvelser med partner"
          ]
        }
      },
      "centralPrinciples": {
        "title": "Centrale Principper",
        "description": "Kernen af hojo undo er den koordinerede brug af krop, åndedræt og sind. Denne harmonisering følger de samme principper som heishugata (Sanchin og Tensho)."
      },
      "historicalBackground": {
        "title": "Historisk Baggrund",
        "description": "De fleste hojo undo redskaber er af kinesisk oprindelse. Kongoken blev opdaget af Chojun Miyagi i Hawaii (1934)."
      },
      "trainingEffects": {
        "title": "Træningseffekter",
        "physical": [
          "Styrkeudvikling af muskler og muskelkæder",
          "Forbedring af styrke-udholdenhed",
          "Udvikling af motoriske færdigheder",
          "Forbedring af holdning og balance"
        ],
        "technical": [
          "Kata forbedring (kaishugata og heishugata)",
          "Mere kraftfulde og stabile grundlæggende teknikker",
          "Mere effektive kampteknikker"
        ],
        "mental": [
          "Forbedret koncentration og mental disciplin",
          "Udvikling af mental styrke",
          "Øgning af selvtillid"
        ]
      },
      "safetyGuidelines": {
        "title": "Sikkerhedsretningslinjer",
        "points": [
          "Start altid med lette vægte og øg gradvist",
          "Fokuser på korrekt teknik frem for vægt",
          "Varm altid op ordentligt før træning",
          "Lyt til din krop og stop ved smerte",
          "Brug altid korrekt åndedrætsteknik"
        ]
      }
    }
