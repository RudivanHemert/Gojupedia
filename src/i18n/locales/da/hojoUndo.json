      "centralPrinciples": {
        "title": "Centrale Principper",
        "description": "Kernen af hojo undo er den koordinerede brug af krop, åndedræt og sind. Denne harmonisering følger de samme principper som heishugata (Sanchin og Tensho)."
      },
      "historicalBackground": {
        "title": "Historisk Baggrund",
        "description": "De fleste hojo undo redskaber er af kinesisk oprindelse. Kongoken blev opdaget af Chojun Miyagi i Hawaii (1934)."
      },
